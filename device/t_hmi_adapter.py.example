"""Template only: connect these functions to the installed T-HMI board driver.

Copy to t_hmi_adapter.py on the device and implement show/read_key for the
exact T-HMI revision. This repository intentionally does not guess the panel,
touch controller, orientation, or GPIO wiring.
"""

KEYS = ("up", "down", "left", "right", "select", "back")


def show(lines):
    # TODO: clear the display and draw each line using the exact panel driver.
    print("[T-HMI DISPLAY]")
    for line in lines:
        print(str(line)[:36])


def read_key():
    # TODO: read touch/buttons and return one KEYS value or None.
    # Return None quickly when no new press; do not block the menu loop.
    return None


def read_text(prompt):
    # Optional: use a board keyboard/text-entry UI for Assistant prompts.
    # None falls back to a serial REPL prompt in main.py.
    return input(prompt + ": ").strip()
